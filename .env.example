# Bot token (Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# OAuth2 (Developer Portal > OAuth2)
CLIENT_ID=
CLIENT_SECRET=

# Dashboard
PORT=3000
# Public URL of the dashboard. Add BASE_URL/auth/callback as a Redirect in the Developer Portal.
BASE_URL=http://localhost:3000
# Long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Comma-separated Discord user IDs allowed to use the "Bot management" page
OWNER_IDS=
